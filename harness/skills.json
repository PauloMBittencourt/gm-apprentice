{
  "_leia-me": "Configuração do harness. Cada gate só vale se uma das skills listadas foi invocada na sessão. Para desligar tudo: crie o arquivo .claude/harness/OFF.",
  "skills": [
    "the-midwife",
    "ttrpg-expert",
    "session-prep",
    "session-play",
    "session-wrapup",
    "campaign-organizer",
    "campaign-qa",
    "vault-ingest",
    "publish-site",
    "qa-passo"
  ],
  "routing": {
    "arcos, aventuras, ideias de campanha": "the-midwife",
    "regras, PNJs, cenas, conteúdo, continuidade": "ttrpg-expert",
    "preparar sessão": "session-prep",
    "durante a sessão": "session-play",
    "depois da sessão (recap, canon)": "session-wrapup",
    "estrutura do vault, ligações, entidades": "campaign-organizer",
    "auditoria, contradições, saúde do vault": "campaign-qa",
    "material antigo": "vault-ingest",
    "site dos jogadores": "publish-site"
  },
  "exempt_write_paths": [
    "^\\.claude/",
    "^CLAUDE\\.md$",
    "^\\.gitignore$",
    "^\\.git/"
  ],
  "vault_write_commands": "gma(\\.py)?\"?\\s+(vault-write|stamp-entities|index-build|relink|links|prop-move|reveal|tones|migrate|update|ingest-images|ingest-survey)\\b.*(--write|--apply|--execute)|gma(\\.py)?\"?\\s+vault-check\\b.*(--fix|report-new)",
  "version_cmd": "vault-check.*\\bversion\\b",
  "content_gate": {
    "exempt_paths": [
      "^_midwife/",
      "^_QA/",
      "^_inbox/",
      "^_Archive/",
      "^_archive/",
      "^\\.claude/",
      "^_attachments/"
    ],
    "max_attempts_per_file": 3
  },
  "gates": [
    {
      "id": "wrapup-gravar",
      "skills": [
        "session-wrapup",
        "vault-ingest"
      ],
      "match": {
        "tools": [
          "Bash",
          "PowerShell",
          "mcp__terminal__run_in_terminal"
        ],
        "cmd": "vault-write\\b.*\\bbatch\\b.*--write"
      },
      "require_reads": [
        "shared/session-principles.md",
        "shared/session-document-chain.md"
      ],
      "require_cmds": [
        "vault-check.*\\bversion\\b"
      ],
      "message": "Wrap-up: gravar o lote só depois do Version Gate e da leitura das referências."
    },
    {
      "id": "plano-gravar",
      "skills": [
        "session-prep"
      ],
      "match": {
        "tools": [
          "Bash",
          "PowerShell",
          "mcp__terminal__run_in_terminal"
        ],
        "cmd": "vault-write\\b.*\\bplan\\b.*--write"
      },
      "require_reads": [
        "shared/session-principles.md",
        "shared/session-document-chain.md",
        "session-prep/references/session-templates.md",
        "ttrpg-expert/arc-spotlight-reference.md"
      ],
      "require_cmds": [
        "vault-check.*\\bversion\\b",
        "session-context.*--prep"
      ],
      "message": "Prep: o Plano só é gravado depois do contexto (--prep) e das referências."
    },
    {
      "id": "play-notes-gravar",
      "skills": [
        "session-play"
      ],
      "match": {
        "tools": [
          "Write",
          "Edit",
          "MultiEdit"
        ],
        "path": "Play Notes\\.md$"
      },
      "require_reads": [
        "shared/session-principles.md",
        "shared/session-document-chain.md"
      ],
      "require_cmds": [
        "vault-check.*\\bversion\\b",
        "session-context.*--play"
      ],
      "message": "Mesa: na primeira invocação rode o Version Gate e 'session-context --play'."
    },
    {
      "id": "midwife-gravar",
      "skills": [
        "the-midwife"
      ],
      "match": {
        "tools": [
          "Write",
          "Edit",
          "MultiEdit"
        ],
        "path": "^_midwife/"
      },
      "require_reads": [
        "shared/session-principles.md"
      ],
      "require_reads_if_exists": [
        "_midwife/index.md"
      ],
      "require_cmds": [
        "vault-check.*\\bversion\\b"
      ],
      "message": "Midwife: leia session-principles, rode o Version Gate e leia _midwife/index.md antes de gravar."
    },
    {
      "id": "organizer-entidade",
      "skills": [
        "campaign-organizer",
        "session-wrapup",
        "vault-ingest"
      ],
      "match": {
        "tools": [
          "Write"
        ],
        "path": "^(Characters|Locations|Factions & Organizations|Items|Creatures|Organizations|Events|Chapters)/"
      },
      "require_reads_any": [
        "_Templates/_Template_"
      ],
      "message": "Entidade nova: leia _Templates/_Template_{Tipo}.md antes de escrever (a regra da skill proíbe copiar de outra entidade)."
    },
    {
      "id": "organizer-esquema",
      "skills": [
        "campaign-organizer"
      ],
      "match": {
        "tools": [
          "Write",
          "Edit",
          "MultiEdit"
        ],
        "path": "^(Characters|Locations|Factions & Organizations|Items|Creatures|Organizations|Events|Chapters|_Campaign)/"
      },
      "require_reads_if_exists": [
        "_meta/entity-types.md",
        "_meta/relationship-types.md",
        "_meta/index.md"
      ],
      "require_cmds": [
        "vault-check.*\\bversion\\b"
      ],
      "message": "Organizer: leia o esquema de _meta/ e rode o Version Gate antes de gravar."
    },
    {
      "id": "ingest-gravar",
      "skills": [
        "vault-ingest"
      ],
      "match": {
        "tools": [
          "Write",
          "Edit",
          "MultiEdit"
        ],
        "path": "^(?!_inbox/|_midwife/|\\.claude/)"
      },
      "require_reads": [
        "shared/session-principles.md",
        "shared/session-document-chain.md",
        "shared/reconcile.md",
        "vault-ingest/references/classification-taxonomy.md",
        "vault-ingest/references/synthesis-templates.md"
      ],
      "require_cmds": [
        "vault-check.*\\bversion\\b",
        "ingest-survey"
      ],
      "message": "Ingest: rode o survey e leia as referências das fases antes de gravar no vault."
    },
    {
      "id": "publicar-site",
      "skills": [
        "publish-site"
      ],
      "match": {
        "tools": [
          "Bash",
          "PowerShell",
          "mcp__terminal__run_in_terminal"
        ],
        "cmd": "publish\\s+deploy|npm run build|npx gm-apprentice-publish\\s+build"
      },
      "require_cmds": [
        "vault-check.*\\bversion\\b",
        "publish\\s+manifest\\s+publish-played"
      ],
      "message": "Site: rode 'publish manifest publish-played' antes de build/deploy, para nenhuma sessão jogada ficar de fora."
    }
  ]
}
